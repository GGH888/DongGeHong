<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="东哥红 V3.12"
            android:textSize="28sp"
            android:textColor="#00D4FF"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="多模型协同推演系统"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="20dp"/>

        <!-- 联赛选择 -->
        <Spinner
            android:id="@+id/leagueSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A2E"
            android:layout_marginBottom="12dp"/>

        <!-- 主队 -->
        <EditText
            android:id="@+id/homeTeamInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="🏠 主队名称"
            android:textColorHint="#666688"
            android:textColor="#FFFFFF"
            android:background="#1A1A2E"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <!-- 客队 -->
        <EditText
            android:id="@+id/awayTeamInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="✈️ 客队名称"
            android:textColorHint="#666688"
            android:textColor="#FFFFFF"
            android:background="#1A1A2E"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- ===== 新增：自动获取数据按钮 ===== -->
        <Button
            android:id="@+id/fetchDataBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📡 自动获取球队数据"
            android:background="#FF6B35"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- 开始预测按钮（原已有） -->
        <Button
            android:id="@+id/predictBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🚀 开始预测"
            android:background="#00D4FF"
            android:textColor="#0F0F1A"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- 结果显示 -->
        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="#1A1A2E"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:minHeight="200dp"
            android:typeface="monospace"/>
    </LinearLayout>
</ScrollView>                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="平"
                android:textColorHint="#666688"
                android:textColor="#FFFFFF"
                android:background="#1A1A2E"
                android:padding="12dp"
                android:inputType="number"
                android:layout_marginEnd="4dp"/>

            <EditText
                android:id="@+id/historyAwayInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="客胜"
                android:textColorHint="#666688"
                android:textColor="#FFFFFF"
                android:background="#1A1A2E"
                android:padding="12dp"
                android:inputType="number"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="例：3 2 5（近10场主胜3平2客胜5）"
            android:textColor="#444466"
            android:textSize="11sp"
            android:layout_marginBottom="12dp"/>

        <!-- 球队状态（可选） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📈 近期状态（可选）"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/homeFormInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="主队状态"
                android:textColorHint="#666688"
                android:textColor="#FFFFFF"
                android:background="#1A1A2E"
                android:padding="12dp"
                android:layout_marginEnd="4dp"/>

            <EditText
                android:id="@+id/awayFormInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="客队状态"
                android:textColorHint="#666688"
                android:textColor="#FFFFFF"
                android:background="#1A1A2E"
                android:padding="12dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="例：5胜3平2负 → 输入 5 3 2"
            android:textColor="#444466"
            android:textSize="11sp"
            android:layout_marginBottom="16dp"/>

        <!-- 预测按钮 -->
        <Button
            android:id="@+id/predictBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🚀 开始预测"
            android:background="#00D4FF"
            android:textColor="#0F0F1A"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <!-- 结果显示 -->
        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="#1A1A2E"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:minHeight="200dp"
            android:typeface="monospace"/>
    </LinearLayout>
</ScrollView>
